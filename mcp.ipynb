%%writefile mcp_logserver.py
import pathlib
from typing import List
from mcp.server.fastmcp import FastMCP

LOG_ROOT = pathlib.Path("./logs").resolve()

server = FastMCP("local-logs-mcp")


@server.tool()
def list_logs(pattern: str = "**/*.log") -> List[str]:
    """
    List log files under LOG_ROOT matching a glob pattern.
    Examples:
      - '**/*.log'
      - 'driver/*.log'
      - 'spark-history/*.log'
    """
    paths = LOG_ROOT.glob(pattern)
    return [
        str(p.relative_to(LOG_ROOT))
        for p in paths
        if p.is_file()
    ]


@server.tool()
def read_log(path: str) -> str:
    """
    Read a log file under LOG_ROOT and return its content as text.
    """
    target = (LOG_ROOT / path).resolve()

    # Prevent escaping outside LOG_ROOT
    if not str(target).startswith(str(LOG_ROOT)):
        raise ValueError("Access outside LOG_ROOT is not allowed")

    if not target.exists():
        raise FileNotFoundError(f"{path} does not exist")

    return target.read_text(encoding="utf-8", errors="ignore")


if __name__ == "__main__":
    # Use stdio transport so the client can spawn this as a subprocess
    server.run(transport="stdio")


import sys
from mcp import ClientSession, StdioServerParameters
from mcp.client.stdio import stdio_client
from mcp.types import TextContent

SERVER_PARAMS = StdioServerParameters(
    command=sys.executable,     # same Python as the notebook
    args=["mcp_logserver.py"],
)


def _unwrap_tool_result(result):
    """
    Convert MCP CallToolResult to something usable (string/list).
    Typically result.content is a list[TextContent].
    """
    content = getattr(result, "content", None)
    if not content:
        return None

    first = content[0]

    if isinstance(first, TextContent):
        return first.text

    # Fallbacks
    if hasattr(first, "text"):
        return first.text
    if hasattr(first, "json"):
        return first.json

    return first


async def call_log_tool(tool_name: str, arguments: dict):
    """
    One-off call to a tool in the logs MCP server.
    Works with both 2-tuple and 3-tuple stdio_client APIs,
    and avoids using ipykernel's stderr (no fileno()).
    """
    async with stdio_client(SERVER_PARAMS, errlog=None) as streams:
        if isinstance(streams, tuple) and len(streams) == 3:
            read_stream, write_stream, _ = streams
        else:
            read_stream, write_stream = streams

        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()
            result = await session.call_tool(tool_name, arguments)
            return _unwrap_tool_result(result)


from typing import TypedDict, Literal, Optional, List
from langgraph.graph import StateGraph, END

Mode = Literal["mcp", "non_mcp"]

class AgentState(TypedDict):
    question: str
    mode: Mode
    answer: Optional[str]
    log_snippets: List[str]


def router_node(state: AgentState) -> AgentState:
    """
    Route only when user explicitly mentions logs / stacktraces / exit codes, etc.
    Everything else goes to non-MCP (Qwen 2.5).
    """
    q = state["question"].lower()

    log_keywords = [
        "log", "logs",
        "driver log", "executor log",
        "stacktrace", "stack trace",
        "spark history",
        "stderr",
        "exit code 137",
        "exit code",
    ]

    if any(k in q for k in log_keywords):
        mode: Mode = "mcp"
    else:
        mode = "non_mcp"

    return {**state, "mode": mode}


import json
from langchain_core.messages import HumanMessage

async def mcp_node(state: AgentState) -> AgentState:
    question = state["question"]

    # 1. Let Qwen 3 decide which glob pattern to use
    system_pattern = (
        "You are a Spark/Kubernetes log analysis assistant. "
        "You have tools list_logs(pattern) and read_log(path). "
        "Given the user's question, choose ONE glob pattern that is likely relevant, "
        "e.g. '**/*.log', 'spark/*.log', 'driver/*.log'. "
        "Return ONLY a JSON object: {\"pattern\": \"...\"}."
    )

    resp = await mcp_llm.ainvoke(
        [("system", system_pattern), HumanMessage(content=question)]
    )

    try:
        data = json.loads(resp.content)
        pattern = data.get("pattern", "**/*.log")
    except Exception:
        pattern = "**/*.log"

    # 2. Use MCP to list logs
    files_raw = await call_log_tool("list_logs", {"pattern": pattern})
    logs_list: List[str] = []

    if isinstance(files_raw, str):
        # try to parse as JSON first
        try:
            logs_list = json.loads(files_raw)
        except Exception:
            logs_list = [line.strip() for line in files_raw.splitlines() if line.strip()]
    elif isinstance(files_raw, list):
        logs_list = files_raw

    # Limit the number of logs we pull
    logs_list = logs_list[:5]

    log_snippets: List[str] = []
    for p in logs_list:
        content = await call_log_tool("read_log", {"path": p})
        snippet = f"===== {p} =====\n{str(content)[:2000]}"
        log_snippets.append(snippet)

    context_block = "\n\n".join(log_snippets) if log_snippets else "No logs available."

    # 3. Ask Qwen 3 to analyze logs
    system_analyze = (
        "You are an expert Spark/Spark-on-Kubernetes/SRE engineer. "
        "Given the user's question and the log snippets, identify likely root cause(s), "
        "supporting evidence from logs, and concrete next steps. "
        "Structure the answer with headings: 'Diagnosis', 'Evidence', 'Next Steps'."
    )

    user_analyze = (
        f"User question:\n{question}\n\n"
        f"LOG SNIPPETS:\n{context_block}"
    )

    final_resp = await mcp_llm.ainvoke(
        [("system", system_analyze), HumanMessage(content=user_analyze)]
    )

    return {
        **state,
        "answer": final_resp.content,
        "log_snippets": log_snippets,
    }


async def non_mcp_node(state: AgentState) -> AgentState:
    question = state["question"]

    system = (
        "You are a senior engineer who knows Spark 3.x, PySpark, Scala, "
        "Python, and general system design. "
        "The user may paste Spark code, error messages, or ask conceptual questions. "
        "Respond with:\n"
        "1. A short summary (1–2 lines)\n"
        "2. Step-by-step reasoning or explanation\n"
        "3. If relevant, a final code block with corrected or improved code."
    )

    resp = await non_mcp_llm.ainvoke(
        [("system", system), HumanMessage(content=question)]
    )

    return {
        **state,
        "answer": resp.content,
    }


from langgraph.graph import StateGraph

graph = StateGraph(AgentState)

# Nodes
graph.add_node("router", router_node)
graph.add_node("mcp_handler", mcp_node)
graph.add_node("non_mcp_handler", non_mcp_node)

# Entry point
graph.set_entry_point("router")


def route_from_mode(state: AgentState):
    """
    Decide which node to go to after router.
    """
    if state["mode"] == "mcp":
        return "mcp_handler"
    return "non_mcp_handler"


# router → (mcp_handler | non_mcp_handler)
graph.add_conditional_edges(
    "router",
    route_from_mode,
)

# Both handlers terminate
graph.add_edge("mcp_handler", END)
graph.add_edge("non_mcp_handler", END)

app = graph.compile()


async def run_agent(question: str) -> AgentState:
    initial: AgentState = {
        "question": question,
        "mode": "non_mcp",   # will be overwritten by router
        "answer": None,
        "log_snippets": [],
    }
    return await app.ainvoke(initial)


q_logs = """
Yesterday's Spark job on Kubernetes failed.
Driver pod restarted multiple times and job eventually failed with exit code 137.
Please inspect the logs to identify the likely root cause and suggest fixes.
"""

result_logs = await run_agent(q_logs)

print("MODE:", result_logs["mode"])
print("ANSWER:\n")
print(result_logs["answer"])


